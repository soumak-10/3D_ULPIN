# =============================================================================
#  Docker Compose environment — repository root
#
#      cp .env.example .env
#      docker compose -f infra/docker-compose.yml --env-file .env up --build
#
#  These values configure the *containers*. Running the services directly on
#  the host instead uses apps/api/.env and apps/web/.env.local, which have
#  their own examples alongside them.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Compose refuses to start without this. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Application -------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
NODE_ENV=development

# Build targets. Flip both to the production stage for a deployment-shaped run:
#   API_TARGET=production WEB_TARGET=production NODE_ENV=production
API_TARGET=development
WEB_TARGET=development

# --- Database ----------------------------------------------------------------
# The superuser owns the extensions and runs the bootstrap; the application
# connects as ulpin_app, which cannot CREATE EXTENSION and cannot UPDATE or
# DELETE audit_logs. That separation is the point — do not collapse it by
# pointing the API at the superuser.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

POSTGRES_USER=ulpin_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ulpin_db
POSTGRES_SCHEMA=ulpin
POSTGRES_PORT=5432

# Loads database/seeds — demonstration buildings, owners, and deliberately
# planted fraud cases so the rules have something to find on a fresh checkout.
# Set false for anything holding real records.
SEED_DATABASE=true

# --- Security ----------------------------------------------------------------
# Rotating this invalidates every stored national_id_hash. Once real data
# exists it is effectively permanent.
ID_HASH_PEPPER=dev-pepper-change-me

# false is correct over plain HTTP on localhost; true (with HTTPS) anywhere
# else, and the API refuses to start with it false outside `local`.
COOKIE_SECURE=false

# --- Ports -------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000
REDIS_PORT=6379

# --- URLs --------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Email delivery (SMTP) ---------------------------------------------------
# Leave SMTP_HOST empty and the API stays fully usable: every message, including
# the six-digit code, is written to the API log instead of being posted. That is
# the intended local default — it means register/verify/reset can be exercised
# end to end with no mail server anywhere.
#
# Gmail: SMTP_PASSWORD must be a 16-character App Password from
# https://myaccount.google.com/apppasswords (2-Step Verification has to be on
# first). Your ordinary account password will be rejected.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#   EMAIL_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on 587. Set false only for a local catcher such as MailHog on 1025.
SMTP_TLS=true
EMAIL_FROM=no-reply@ulpin.gov.in
EMAIL_FROM_NAME=ULPIN Registry

# --- One-time passcodes ------------------------------------------------------
# Six digits is 10^6, so the expiry and the attempt cap are the real defences,
# not the length. Raising OTP_MAX_ATTEMPTS weakens both.
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
# Attempts before the code is burned and a new one must be requested.
OTP_MAX_ATTEMPTS=5
# Send throttle: one code per minute, five per rolling hour, per account.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# How long the ticket minted by /auth/verify-reset-otp stays good. The code
# itself is spent at that point; this is only the window for typing a password.
RESET_TICKET_EXPIRE_MINUTES=15

# false lets unverified accounts sign in. Leave it true — the spec requires
# verification before login, and false exists only for a demo where no mail
# server is reachable and the log is not visible either.
REQUIRE_EMAIL_VERIFICATION=true
