# =============================================================================
# Backend environment — apps/api
#
# Copy to `.env` and edit. Every key below is read by `app/core/config.py`,
# which validates at import time: a bad value stops the process at startup
# rather than surfacing on whichever request happens to touch it first.
#
# Settings marked REQUIRED IN PRODUCTION are enforced by the model validator
# in that file when ENVIRONMENT is `staging` or `production`.
# =============================================================================

# --- Application -------------------------------------------------------------
PROJECT_NAME="3D ULPIN Generation and Vertical Property Mapping System"
API_V1_PREFIX=/api/v1
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true                   # must be false outside local
VERSION=1.0.0

# --- Security ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, a random key is generated per process — which means every restart
# invalidates every token and two replicas never agree. Fine locally, fatal
# anywhere else, so the production guard refuses a key under 32 characters.
SECRET_KEY=

JWT_ALGORITHM=HS256
JWT_ISSUER=ulpin-api
JWT_AUDIENCE=ulpin-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_TOKEN_EXPIRE_HOURS=48

# REQUIRED IN PRODUCTION. Pepper mixed in before hashing statutory identifiers
# (Aadhaar, PAN). Rotating it invalidates every stored national_id_hash, so
# once real data exists this value is effectively permanent — back it up
# wherever you back up the database.
ID_HASH_PEPPER=dev-pepper-change-me

# Argon2id cost. Defaults target roughly 100 ms on a 2-core container; raise
# ARGON2_MEMORY_COST before raising time cost if you have the RAM.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536     # KiB, so 64 MiB
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- CORS and hosts ----------------------------------------------------------
# Comma-separated or a JSON array; both parse. In the normal deployment the
# browser never calls the API cross-origin (Next rewrites /api/v1 to it), so
# this matters only for direct API clients and the docs page.
BACKEND_CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*              # must be explicit outside local

# --- Database ----------------------------------------------------------------
# Under docker compose the host is the service name, `postgres`.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ulpin_app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ulpin_db
POSTGRES_SCHEMA=ulpin

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false                # logs every statement; very loud

# --- Redis -------------------------------------------------------------------
# Rate limiting is per-process without Redis, which means N replicas allow N
# times the configured rate. Point this at a real instance before scaling out.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST empty to disable sending. Password-reset tokens are then
# written to the application log instead, which is what you want locally and
# must never be what happens in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@ulpin.gov.in
EMAIL_FROM_NAME="ULPIN Registry"
FRONTEND_URL=http://localhost:3000

# --- Geospatial --------------------------------------------------------------
# Geometry is stored in WGS 84 (4326) and measured in EPSG:7755, the metric
# Lambert conformal conic for India. Areas and volumes computed in degrees are
# meaningless, so the metric SRID is not optional — only its choice is.
STORAGE_SRID=4326
DEFAULT_METRIC_SRID=7755
DEFAULT_VERTICAL_DATUM=EGM2008
GEOM_TOLERANCE_M=0.01

# --- Cookies -----------------------------------------------------------------
# The refresh token lives here; the access token is held in memory by the SPA
# and never written to storage JavaScript can read.
COOKIE_NAME_REFRESH=ulpin_rt
COOKIE_DOMAIN=
COOKIE_SECURE=false          # set true (and serve over HTTPS) outside local
COOKIE_SAMESITE=lax
